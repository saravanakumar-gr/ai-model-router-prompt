<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <HTTPProxyConnection>
        <BasePath>/ai-model-router-prompt</BasePath>
    </HTTPProxyConnection>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>verify-api-key-Verify-API-Key</Name>
            </Step>
            <Step>
                <Name>prompt-router-AM-BuildFlashLiteRequest</Name>
            </Step>
            <Step>
                <Name>prompt-router-SC-CallGeminiFlashLite</Name>
            </Step>
            <Step>
                <Name>prompt-router-EV-ParseFlashResponse</Name>
            </Step>
        </Request>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Response>
            <Step>
                <Name>prompt-router-AM-SetSimpleResponse</Name>
                <Condition>flashlite.classification ~~ "(?s).*classification.\s*:\s*.SIMPLE.*"</Condition>
            </Step>
            <Step>
                <Name>prompt-router-AM-SetMediumHeaders</Name>
                <Condition>flashlite.classification ~~ "(?s).*classification.\s*:\s*.MEDIUM.*"</Condition>
            </Step>
            <Step>
                <Name>prompt-router-AM-SetComplexHeaders</Name>
                <Condition>flashlite.classification ~~ "(?s).*classification.\s*:\s*.COMPLEX.*"</Condition>
            </Step>
        </Response>
    </PostFlow>
    <RouteRule name="GeminiFlashTarget">
        <Condition>flashlite.classification ~~ "(?s).*classification.\s*:\s*.MEDIUM.*"</Condition>
        <TargetEndpoint>gemini-flash-target</TargetEndpoint>
    </RouteRule>
    <RouteRule name="GeminiArgonTarget">
        <Condition>flashlite.classification ~~ "(?s).*classification.\s*:\s*.COMPLEX.*"</Condition>
        <TargetEndpoint>gemini-argon-target</TargetEndpoint>
    </RouteRule>
    <RouteRule name="NoRoute"/>
</ProxyEndpoint>
